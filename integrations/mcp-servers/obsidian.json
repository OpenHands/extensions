{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/obsidian",
  "description": "Read and edit Markdown notes inside an Obsidian vault on the local disk.",
  "title": "Obsidian",
  "websiteUrl": "https://github.com/MarkusPfundstein/mcp-obsidian",
  "repository": {
    "url": "https://github.com/MarkusPfundstein/mcp-obsidian",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mcp-obsidian",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OBSIDIAN_API_KEY",
          "description": "From the Obsidian 'Local REST API' community plugin.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "obsidian",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "api",
      "connectionOptions": [
        {
          "id": "api",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "obsidian",
            "command": "uvx",
            "args": [
              "mcp-obsidian"
            ],
            "envFields": [
              {
                "key": "OBSIDIAN_API_KEY",
                "label": "Local REST API key",
                "type": "password",
                "required": true,
                "helperText": "From the Obsidian 'Local REST API' community plugin.",
                "helperLink": "https://github.com/coddingtonbear/obsidian-local-rest-api"
              }
            ]
          },
          "auth": {
            "strategy": "api_key"
          }
        }
      ],
      "keywords": [
        "notes",
        "knowledge",
        "markdown",
        "vault"
      ]
    }
  }
}
