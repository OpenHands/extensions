{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/cloudflare-builds",
  "description": "Inspect Workers Builds — logs, statuses, and rerun failed deploys.",
  "title": "Cloudflare Builds",
  "websiteUrl": "https://developers.cloudflare.com/agents/model-context-protocol/",
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://builds.mcp.cloudflare.com/mcp"
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "cloudflare-builds",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "oauth",
      "connectionOptions": [
        {
          "id": "oauth",
          "provider": "mcp",
          "transport": {
            "kind": "shttp",
            "url": "https://builds.mcp.cloudflare.com/mcp"
          },
          "auth": {
            "strategy": "oauth2"
          }
        }
      ],
      "keywords": [
        "cloudflare",
        "workers",
        "ci",
        "builds",
        "deploys"
      ]
    }
  }
}
