{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/exa",
  "description": "Neural web search with semantic ranking, content extraction, and similar-page lookup.",
  "title": "Exa",
  "websiteUrl": "https://docs.exa.ai/reference/exa-mcp",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "exa-mcp-server",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EXA_API_KEY",
          "description": "API key from your Exa account.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "exa",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "api",
      "connectionOptions": [
        {
          "id": "api",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "exa",
            "command": "npx",
            "args": [
              "-y",
              "exa-mcp-server"
            ],
            "envFields": [
              {
                "key": "EXA_API_KEY",
                "label": "Exa API key",
                "type": "password",
                "required": true,
                "helperText": "API key from your Exa account.",
                "helperLink": "https://exa.ai/docs/reference/getting-started"
              }
            ]
          },
          "auth": {
            "strategy": "api_key"
          }
        }
      ],
      "keywords": [
        "search",
        "web",
        "research",
        "neural"
      ]
    }
  }
}
