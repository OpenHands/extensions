{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/apify",
  "description": "Run any of Apify's 5,000+ Actors (scrapers, automations) from the agent.",
  "title": "Apify Actors",
  "websiteUrl": "https://docs.apify.com/platform/integrations/mcp",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@apify/actors-mcp-server",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "API token from your Apify account settings.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "apify",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "api",
      "connectionOptions": [
        {
          "id": "api",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "apify",
            "command": "npx",
            "args": [
              "-y",
              "@apify/actors-mcp-server"
            ],
            "envFields": [
              {
                "key": "APIFY_TOKEN",
                "label": "Apify token",
                "type": "password",
                "required": true,
                "helperText": "API token from your Apify account settings.",
                "helperLink": "https://console.apify.com/account/integrations"
              }
            ]
          },
          "auth": {
            "strategy": "api_key"
          }
        }
      ],
      "keywords": [
        "scraping",
        "automation",
        "crawl",
        "actors"
      ]
    }
  }
}
