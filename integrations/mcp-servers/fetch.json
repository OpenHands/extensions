{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/fetch",
  "description": "Plain HTTP fetcher: download a URL and convert HTML to readable markdown.",
  "title": "Fetch",
  "websiteUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
  "repository": {
    "url": "https://github.com/modelcontextprotocol/servers",
    "source": "github",
    "subfolder": "src/fetch"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mcp-server-fetch",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "fetch",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "none",
      "connectionOptions": [
        {
          "id": "none",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "fetch",
            "command": "uvx",
            "args": [
              "mcp-server-fetch"
            ]
          },
          "auth": {
            "strategy": "none"
          }
        }
      ],
      "keywords": [
        "http",
        "web",
        "url",
        "scrape"
      ]
    }
  }
}
