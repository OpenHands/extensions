{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/browser-mcp",
  "description": "Control your local browser tab — navigate, click, type, and read DOM contents.",
  "title": "Browser MCP",
  "websiteUrl": "https://browsermcp.io/",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@browsermcp/mcp",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "browser-mcp",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "none",
      "connectionOptions": [
        {
          "id": "none",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "browser_mcp",
            "command": "npx",
            "args": [
              "-y",
              "@browsermcp/mcp"
            ]
          },
          "auth": {
            "strategy": "none"
          }
        }
      ],
      "keywords": [
        "browser",
        "automation",
        "chrome",
        "playwright"
      ]
    }
  }
}
