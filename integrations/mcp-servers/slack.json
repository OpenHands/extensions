{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/slack",
  "description": "Read channels, post messages, and search workspace history from your agent.",
  "title": "Slack",
  "websiteUrl": "https://github.com/zencoderai/slack-mcp-server",
  "repository": {
    "url": "https://github.com/zencoderai/slack-mcp-server",
    "source": "github"
  },
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.slack.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@zencoderai/slack-mcp-server",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SLACK_TEAM_ID",
          "description": "First get your [Slack URL](https://slack.com/help/articles/221769328-Locate-your-Slack-URL-or-ID#find-your-url). Then use that to get your [Workspace ID](https://slack.com/help/articles/221769328-Locate-your-Slack-URL-or-ID#find-your-workspace-or-org-id).",
          "isRequired": true,
          "isSecret": false,
          "placeholder": "T01234567"
        },
        {
          "name": "SLACK_BOT_TOKEN",
          "description": "You'll need to create or have access to a [Slack App](https://github.com/zencoderai/slack-mcp-server#slack-bot-setup) to get a Bot token.",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "xoxb-..."
        }
      ]
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "slack",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "oauth",
      "connectionOptions": [
        {
          "id": "oauth",
          "provider": "mcp",
          "connectionModel": {
            "principalType": "user",
            "credentialScope": "resource",
            "resourceType": "workspace",
            "resourceCardinality": "one",
            "selectionMode": "automatic",
            "identityMapping": {
              "source": "oauth_token_response",
              "externalPrincipalIdPath": "authed_user.id",
              "externalTenantIdPath": "enterprise.id",
              "externalResourceIdPath": "team.id",
              "resourceNamePath": "team.name"
            }
          },
          "auth": {
            "strategy": "oauth2",
            "oauth": {
              "authorizationUrl": "https://slack.com/oauth/v2_user/authorize",
              "tokenUrl": "https://slack.com/api/oauth.v2.user.access",
              "scopes": [
                "search:read.public",
                "search:read.private",
                "search:read.mpim",
                "search:read.im",
                "search:read.files",
                "search:read.users",
                "chat:write",
                "channels:history",
                "groups:history",
                "mpim:history",
                "im:history",
                "canvases:read",
                "canvases:write",
                "users:read",
                "users:read.email"
              ],
              "pkce": true,
              "clientAuthentication": "body"
            }
          },
          "transport": {
            "kind": "shttp",
            "url": "https://mcp.slack.com/mcp"
          }
        },
        {
          "id": "api",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "slack",
            "command": "npx",
            "args": [
              "-y",
              "@zencoderai/slack-mcp-server"
            ],
            "envFields": [
              {
                "key": "SLACK_TEAM_ID",
                "label": "Team / Workspace ID",
                "type": "text",
                "placeholder": "T01234567",
                "helperText": "First get your [Slack URL](https://slack.com/help/articles/221769328-Locate-your-Slack-URL-or-ID#find-your-url). Then use that to get your [Workspace ID](https://slack.com/help/articles/221769328-Locate-your-Slack-URL-or-ID#find-your-workspace-or-org-id).",
                "required": true
              },
              {
                "key": "SLACK_BOT_TOKEN",
                "label": "Bot token",
                "type": "password",
                "placeholder": "xoxb-...",
                "required": true,
                "helperText": "You'll need to create or have access to a [Slack App](https://github.com/zencoderai/slack-mcp-server#slack-bot-setup) to get a Bot token."
              }
            ]
          },
          "auth": {
            "strategy": "api_key"
          }
        }
      ],
      "installHint": "Create a Slack app with bot token scopes channels:history, channels:read, chat:write, reactions:write, users:read, and users.profile:read, then paste its bot token below.",
      "keywords": [
        "chat",
        "messaging",
        "team"
      ],
      "categories": [
        "Communication",
        "Operations"
      ],
      "popularityRank": 95,
      "notes": "The OAuth option uses Slack's official hosted MCP server (confidential OAuth user-token auth); the local option runs the open-source zencoderai stdio server with a bot token."
    }
  }
}
