{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.openhands/resend",
  "description": "Send transactional and marketing emails via the Resend API.",
  "title": "Resend",
  "websiteUrl": "https://resend.com/docs/mcp",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-send-email",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RESEND_API_KEY",
          "description": "API key from your Resend dashboard.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "SENDER_EMAIL_ADDRESS",
          "description": "From address",
          "isRequired": true,
          "isSecret": false,
          "placeholder": "you@example.com"
        }
      ]
    }
  ],
  "_meta": {
    "dev.openhands": {
      "catalogId": "resend",
      "descriptorVersion": "1.0.0",
      "schemaDate": "2025-12-11",
      "defaultMcpConnectionOptionId": "api",
      "connectionOptions": [
        {
          "id": "api",
          "provider": "mcp",
          "transport": {
            "kind": "stdio",
            "serverName": "resend",
            "command": "npx",
            "args": [
              "-y",
              "mcp-send-email"
            ],
            "envFields": [
              {
                "key": "RESEND_API_KEY",
                "label": "Resend API key",
                "type": "password",
                "required": true,
                "helperText": "API key from your Resend dashboard.",
                "helperLink": "https://resend.com/api-keys"
              },
              {
                "key": "SENDER_EMAIL_ADDRESS",
                "label": "From address",
                "type": "text",
                "placeholder": "you@example.com",
                "required": true
              }
            ]
          },
          "auth": {
            "strategy": "api_key"
          }
        }
      ],
      "keywords": [
        "email",
        "transactional",
        "smtp"
      ]
    }
  }
}
