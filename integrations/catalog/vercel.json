{
  "id": "vercel",
  "name": "Vercel",
  "description": "Deployments, projects, domains, and preview environment workflows.",
  "categories": [
    "Developer tools",
    "Deployment"
  ],
  "appUrl": "https://vercel.com",
  "docsUrl": "https://vercel.com/docs/agent-resources/vercel-mcp",
  "notes": "Especially relevant to this repo's deployment model. The MCP option uses Vercel's official hosted MCP server; OAuth is handled by the server, so no client credentials are required - sign in with your Vercel account when the authentication flow starts.",
  "popularityRank": 39,
  "connectionOptions": [
    {
      "id": "oauth-mcp",
      "provider": "mcp",
      "transport": {
        "kind": "shttp",
        "url": "https://mcp.vercel.com"
      },
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "clientAuthentication": "none"
        }
      }
    },
    {
      "id": "oauth",
      "provider": "http",
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "authorizationUrl": "https://vercel.com/oauth/authorize",
          "tokenUrl": "https://api.vercel.com/v2/oauth/access_token",
          "scopes": [
            "project:read"
          ]
        }
      },
      "http": {
        "apiBaseUrl": "https://api.vercel.com",
        "openApiUrl": "https://api.apis.guru/v2/specs/vercel.com/0.0.1/openapi.json"
      }
    }
  ]
}
