{
  "id": "treg",
  "name": "Treg",
  "description": "Find and call tools for web search, SEO, company enrichment, and media generation. Inspect each tool's inputs and price before running it.",
  "categories": [
    "Search",
    "Developer tools"
  ],
  "appUrl": "https://treg.to",
  "docsUrl": "https://treg.to/llms.txt",
  "logoUrl": "https://treg.to/media/brand/logo.png",
  "keywords": [
    "web search",
    "keyword research",
    "company enrichment",
    "social data",
    "media generation"
  ],
  "installHint": "Sign in to Treg and choose a team during OAuth, or connect with a team API key. To try the connection, use catalog_get with endpoint_id set to treg.web.search. Looking up a tool is free. Paid calls using Treg's provider credentials draw from the selected team's prepaid balance.",
  "connectionOptions": [
    {
      "id": "oauth",
      "provider": "mcp",
      "transport": {
        "kind": "shttp",
        "url": "https://treg.to/mcp/"
      },
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "authorizationUrl": "https://treg.to/oauth/authorize",
          "tokenUrl": "https://treg.to/oauth/token",
          "registrationUrl": "https://treg.to/oauth/register",
          "scopes": [
            "treg:catalog",
            "treg:call",
            "treg:read"
          ],
          "pkce": true,
          "clientAuthentication": "none",
          "additionalAuthorizationParams": {
            "resource": "https://treg.to/mcp/"
          },
          "additionalTokenParams": {
            "resource": "https://treg.to/mcp/"
          }
        }
      }
    },
    {
      "id": "api",
      "provider": "mcp",
      "transport": {
        "kind": "shttp",
        "url": "https://treg.to/mcp/"
      },
      "auth": {
        "strategy": "bearer",
        "credentialLabel": "Treg team API key",
        "credentialHelp": "Open Team in the [Treg dashboard](https://treg.to/app) and copy a key from the API Keys tab.",
        "credentialSecretName": "TREG_TOKEN"
      }
    }
  ]
}
