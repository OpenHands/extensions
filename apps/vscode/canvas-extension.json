{
  "schema_version": 1,
  "name": "vscode",
  "display_name": "VS Code",
  "version": "0.1.0",
  "description": "A managed code-server editor for Agent Canvas.",
  "entrypoint": "extension.js",
  "contributes": {
    "pages": [
      {
        "id": "editor",
        "title": "VS Code",
        "path": "/editor"
      }
    ]
  },
  "backend": {
    "schema_version": 1,
    "artifacts": {
      "linux-amd64": {
        "url": "https://github.com/coder/code-server/releases/download/v4.145.2/code-server-4.145.2-linux-amd64.tar.gz",
        "sha256": "2f6db6c3e8b733dd6b3aeee83532e148b2bae2e392353ba85452d03572348962",
        "strip_components": 1
      },
      "linux-arm64": {
        "url": "https://github.com/coder/code-server/releases/download/v4.145.2/code-server-4.145.2-linux-arm64.tar.gz",
        "sha256": "e867a34416e2da4a83496b09580001893e7a4e5bb58a0624c4fcd22819e7d53d",
        "strip_components": 1
      }
    },
    "argv": [
      "{artifact_dir}/bin/code-server",
      "--bind-addr",
      "127.0.0.1:{port}",
      "--auth",
      "none",
      "--disable-telemetry",
      "--disable-update-check",
      "--disable-proxy",
      "--ignore-last-opened",
      "--user-data-dir",
      "{data_dir}/user",
      "--extensions-dir",
      "{data_dir}/extensions"
    ],
    "health": {
      "path": "/",
      "timeout_seconds": 90,
      "interval_seconds": 0.5
    },
    "inherit_environment": [
      "PATH",
      "LANG",
      "LC_ALL",
      "TMPDIR"
    ],
    "additional_artifacts": {
      "darwin-amd64": {
        "url": "https://github.com/coder/code-server/releases/download/v4.145.2/code-server-4.145.2-macos-amd64.tar.gz",
        "sha256": "5fb7ac2bd60538400244d942f649559e0ff4fb3d8792979287f504780f357af6",
        "strip_components": 1
      },
      "darwin-arm64": {
        "url": "https://github.com/coder/code-server/releases/download/v4.145.2/code-server-4.145.2-macos-arm64.tar.gz",
        "sha256": "d6699692f1e59d918517c81f9d2a4ef335132128cd45725b22236d5fe09636d4",
        "strip_components": 1
      }
    }
  }
}
