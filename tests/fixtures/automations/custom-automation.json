    {
      "id": "scheduled-prompt",
      "description": "A custom prompt automation that runs on a weekday schedule and clones one repository.",
      "selectedAction": "prompt",
      "selectedTrigger": "cron",
      "formValues": {
        "name": "Daily extensions summary",
        "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
        "repository": "OpenHands/extensions",
        "ref": "main",
        "model": "fast",
        "timeout": 900,
        "schedule": "0 9 * * 1-5",
        "timezone": "UTC"
      },
      "preflight": {
        "request": {
          "method": "POST",
          "path": "/v1/validate",
          "body": {
            "automationId": "custom-automation",
            "endpoint": "/v1/preset/prompt",
            "draft": {
              "name": "Daily extensions summary",
              "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
              "model": "fast",
              "timeout": 900,
              "repos": [
                {
                  "url": "OpenHands/extensions",
                  "provider": "github",
                  "ref": "main"
                }
              ],
              "trigger": {
                "type": "cron",
                "schedule": "0 9 * * 1-5",
                "timezone": "UTC"
              }
            }
          }
        },
        "response": {
          "status": 200,
          "body": {
            "valid": true,
            "errors": []
          }
        }
      },
      "create": {
        "request": {
          "method": "POST",
          "path": "/v1/preset/prompt",
          "body": {
            "name": "Daily extensions summary",
