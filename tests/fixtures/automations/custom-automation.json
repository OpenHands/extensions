              {
                "url": "OpenHands/extensions",
                "provider": "github",
                "ref": "main"
              }
            ],
            "trigger": {
              "type": "cron",
              "schedule": "0 9 * * 1-5",
              "timezone": "UTC"
            }
          }
        },
        "response": {
          "status": 201,
          "body": {
            "id": "1c0b7ea0-0000-4000-8000-000000000001",
