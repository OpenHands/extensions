{
  "automationId": "custom-prompt-automation",
  "description": "Direct generic prompt setup. The form can create a scheduled prompt automation or an event-driven prompt automation from the same catalog entry; selectedTrigger records the host UI variant chosen for each scenario.",
  "capabilities": "supported",
  "blockedBy": [
    "notReady"
  ],
  "scenarios": [
    {
      "id": "scheduled-prompt",
      "description": "A custom prompt automation that runs on a weekday schedule, clones one repository, and pins a model profile and timeout.",
      "selectedTrigger": "cron",
      "formValues": {
        "name": "Daily extensions summary",
        "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
        "repository": "OpenHands/extensions",
        "ref": "main",
        "model": "fast",
        "timeout": 900,
        "schedule": "0 9 * * 1-5",
        "timezone": "UTC"
      },
      "preflight": {
        "request": {
          "method": "POST",
          "path": "/v1/validate",
          "body": {
            "automationId": "custom-prompt-automation",
            "endpoint": "/v1/preset/prompt",
            "draft": {
              "name": "Daily extensions summary",
              "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
              "model": "fast",
              "timeout": 900,
              "repos": [
                {
                  "url": "OpenHands/extensions",
                  "provider": "github",
                  "ref": "main"
                }
              ],
              "trigger": {
                "type": "cron",
                "schedule": "0 9 * * 1-5",
                "timezone": "UTC"
              }
            }
          }
        },
        "response": {
          "status": 200,
          "body": {
            "valid": true,
            "errors": []
          }
        }
      },
      "create": {
        "request": {
          "method": "POST",
          "path": "/v1/preset/prompt",
          "body": {
            "name": "Daily extensions summary",
            "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
            "model": "fast",
            "timeout": 900,
            "repos": [
              {
                "url": "OpenHands/extensions",
                "provider": "github",
                "ref": "main"
              }
            ],
            "trigger": {
              "type": "cron",
              "schedule": "0 9 * * 1-5",
              "timezone": "UTC"
            }
          }
        },
        "response": {
          "status": 201,
          "body": {
            "id": "1c0b7ea0-0000-4000-8000-000000000001",
            "model": "fast",
            "name": "Daily extensions summary",
            "prompt": "Summarize recent changes in the OpenHands/extensions repository and save a concise report in the workspace.",
            "trigger": {
              "type": "cron",
              "schedule": "0 9 * * 1-5",
              "timezone": "UTC"
            },
            "timeout": 900,
            "enabled": true
          }
        }
      }
    },
    {
      "id": "event-prompt",
      "description": "A custom prompt automation that runs on a GitHub comment event, uses the selected event source and type, and applies the user-provided JMESPath filter.",
      "selectedTrigger": "event",
      "formValues": {
        "name": "OpenHands mention responder",
        "prompt": "When triggered, read the GitHub issue or pull request context and draft a helpful response for the user.",
        "repository": "OpenHands/extensions",
        "ref": "main",
        "model": "",
        "timeout": 600,
        "source": "github",
        "on": "issue_comment.created",
        "filter": "glob(repository.full_name, 'OpenHands/extensions') && icontains(comment.body, '@openhands')"
      },
      "preflight": {
        "request": {
          "method": "POST",
          "path": "/v1/validate",
          "body": {
            "automationId": "custom-prompt-automation",
            "endpoint": "/v1/preset/prompt",
            "draft": {
              "name": "OpenHands mention responder",
              "prompt": "When triggered, read the GitHub issue or pull request context and draft a helpful response for the user.",
              "timeout": 600,
              "repos": [
                {
                  "url": "OpenHands/extensions",
                  "provider": "github",
                  "ref": "main"
                }
              ],
              "trigger": {
                "type": "event",
                "source": "github",
                "on": "issue_comment.created",
                "filter": "glob(repository.full_name, 'OpenHands/extensions') && icontains(comment.body, '@openhands')"
              }
            }
          }
        },
        "response": {
          "status": 200,
          "body": {
            "valid": true,
            "errors": []
          }
        }
      },
      "create": {
        "request": {
          "method": "POST",
          "path": "/v1/preset/prompt",
          "body": {
            "name": "OpenHands mention responder",
            "prompt": "When triggered, read the GitHub issue or pull request context and draft a helpful response for the user.",
            "timeout": 600,
            "repos": [
              {
                "url": "OpenHands/extensions",
                "provider": "github",
                "ref": "main"
              }
            ],
            "trigger": {
              "type": "event",
              "source": "github",
              "on": "issue_comment.created",
              "filter": "glob(repository.full_name, 'OpenHands/extensions') && icontains(comment.body, '@openhands')"
            }
          }
        },
        "response": {
          "status": 201,
          "body": {
            "id": "1c0b7ea0-0000-4000-8000-000000000002",
            "model": null,
            "name": "OpenHands mention responder",
            "prompt": "When triggered, read the GitHub issue or pull request context and draft a helpful response for the user.",
            "trigger": {
              "type": "event",
              "source": "github",
              "on": "issue_comment.created",
              "filter": "glob(repository.full_name, 'OpenHands/extensions') && icontains(comment.body, '@openhands')"
            },
            "timeout": 600,
            "enabled": true
          }
        }
      }
    }
  ]
}
