{
  "name": "github-issue-triage",
  "version": "1.1.0",
  "description": "Prioritize open issues and establish acceptance criteria before marking them ready for development.",
  "author": {
    "name": "OpenHands"
  },
  "license": "MIT",
  "homepage": "https://github.com/OpenHands/extensions",
  "repository": "https://github.com/OpenHands/extensions",
  "keywords": [
    "automation"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 plugin_runner.py worker.py"
    },
    "runtime": {
      "plugins": [],
      "agent_profile": {
        "required": true,
        "default_name": "default",
        "allowed_tools": [
          "terminal",
          "file_editor",
          "task_tracker",
          "browser_tool_set"
        ]
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "default": [
            "OpenHands/extensions"
          ]
        },
        "github_token_secret": {
          "type": "string",
          "default": "GITHUB_PERSONAL_ACCESS_TOKEN"
        }
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "*/5 * * * *",
      "timezone": "UTC"
    }
  }
}
