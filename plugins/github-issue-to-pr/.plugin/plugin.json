{
  "name": "github-issue-to-pr",
  "version": "1.0.0",
  "description": "Create an automation that implements GitHub issues when a configurable trigger label is applied. It clones the default branch, starts one OpenHands conversation per label event, then commits, pushes, and opens the pull request itself, without ever handing the agent a GitHub credential.",
  "author": {
    "name": "OpenHands",
    "email": "contact@all-hands.dev"
  },
  "homepage": "https://github.com/OpenHands/extensions",
  "repository": "https://github.com/OpenHands/extensions",
  "license": "MIT",
  "keywords": [
    "github",
    "issue",
    "pull-request",
    "automation",
    "integration"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 plugin_runner.py worker.py"
    },
    "runtime": {
      "plugins": [],
      "agent_profile": {
        "required": true,
        "default_name": "agent-default",
        "allowed_tools": [
          "terminal",
          "file_editor",
          "task_tracker",
          "browser_tool_set"
        ]
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "default": [
            "OpenHands/extensions"
          ]
        },
        "trigger_label": {
          "type": "string",
          "default": "openhands"
        },
        "branch_prefix": {
          "type": "string",
          "default": "openhands/issue"
        },
        "pull_request_mode": {
          "type": "string",
          "enum": [
            "draft",
            "ready"
          ],
          "default": "draft"
        },
        "github_token_secret": {
          "type": "string",
          "default": "GITHUB_PERSONAL_ACCESS_TOKEN"
        }
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "*/15 * * * *",
      "timezone": "UTC"
    }
  }
}
