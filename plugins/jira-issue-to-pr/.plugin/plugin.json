{
  "name": "jira-issue-to-pr",
  "version": "1.0.0",
  "description": "Deploy a cron-based OpenHands automation that opens a GitHub pull request, a GitLab merge request or a Bitbucket pull request for each Jira issue carrying a configurable label (default: create-pr). The target repository is read from the ticket body - no repo parameter required at deploy time.",
  "author": {
    "name": "OpenHands",
    "email": "contact@all-hands.dev"
  },
  "homepage": "https://github.com/OpenHands/extensions",
  "repository": "https://github.com/OpenHands/extensions",
  "license": "MIT",
  "keywords": [
    "jira",
    "atlassian",
    "github",
    "gitlab",
    "bitbucket",
    "pull-request",
    "merge-request",
    "automation"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 plugin_runner.py main.py"
    },
    "runtime": {
      "plugins": [],
      "agent_profile": {
        "required": true,
        "default_name": "agent-default",
        "allowed_tools": [
          "terminal",
          "file_editor",
          "task_tracker",
          "browser_tool_set"
        ]
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jira_base_url": {
          "type": "string",
          "default": "https://example.atlassian.net"
        },
        "jira_email": {
          "type": "string",
          "default": "user@example.com"
        },
        "jira_token_secret": {
          "type": "string",
          "default": "JIRA_CLOUD_KEY"
        },
        "jira_label": {
          "type": "string",
          "default": "create-pr"
        },
        "git_provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "bitbucket"
          ],
          "default": "github"
        },
        "max_new_per_run": {
          "type": "integer",
          "default": 5
        }
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "*/5 * * * *",
      "timezone": "UTC"
    }
  }
}
