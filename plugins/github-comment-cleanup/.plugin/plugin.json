{
  "name": "github-comment-cleanup",
  "version": "1.0.0",
  "description": "Run the comment-cleanup skill on GitHub repositories on a schedule. Files are fingerprinted by git blob SHA so the agent only reads files changed since they were last examined, and each run opens at most one pull request per repository.",
  "author": {
    "name": "OpenHands",
    "email": "contact@all-hands.dev"
  },
  "homepage": "https://github.com/OpenHands/extensions",
  "repository": "https://github.com/OpenHands/extensions",
  "license": "MIT",
  "keywords": [
    "github",
    "comments",
    "cleanup",
    "code-quality",
    "automation"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 plugin_runner.py main.py"
    },
    "runtime": {
      "agent_profile": {
        "required": true,
        "default_name": "default",
        "allowed_tools": [
          "terminal",
          "file_editor",
          "task_tracker",
          "browser_tool_set"
        ]
      },
      "plugins": [
        {
          "source": "github:OpenHands/extensions",
          "repo_path": "skills/comment-cleanup"
        }
      ]
    },
    "config_schema": {
      "type": "object",
      "required": [
        "repos"
      ],
      "additionalProperties": false,
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 10000,
          "default": 1000000
        },
        "branch_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "default": "openhands/comment-cleanup"
        },
        "pull_request_mode": {
          "type": "string",
          "enum": [
            "draft",
            "ready"
          ],
          "default": "draft"
        }
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "0 9 * * 1",
      "timezone": "UTC"
    }
  }
}
