{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenHands/extensions/automations/catalog.schema.json",
  "title": "AutomationCatalogEntry",
  "description": "Strict schema for automations/catalog/<id>/manifest.json. Mirrors automations/index.d.ts. An entry carries the card metadata Agent Canvas renders plus, optionally, the extension-owned setup contract for that automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description",
    "requiredIntegrationIds",
    "popularityRank",
    "estimatedSetupMinutes",
    "prompt",
    "exampleImplementation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable identifier. Must equal the name of the directory holding this manifest."
    },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "requiredIntegrationIds": {
      "description": "Each id must resolve to an integrations/catalog entry.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "popularityRank": { "type": "integer", "minimum": 0 },
    "estimatedSetupMinutes": { "type": "integer", "minimum": 1 },
    "prompt": {
      "description": "The slash command Agent Canvas sends when the card is launched today.",
      "type": "string",
      "minLength": 1
    },
    "exampleImplementation": {
      "description": "What the skill behind `prompt` builds. Documentation for authors; Agent Canvas does not render it.",
      "type": "string",
      "minLength": 1
    },
    "setup": { "$ref": "#/$defs/setup" }
  },
  "$defs": {
    "setup": {
      "description": "The extension-owned configuration experience for this automation: what the deployment must support, what must be connected first, what the user is asked, how a draft is validated, what request is sent, and which analytics stages are emitted. It never describes what the automation does at runtime - that is the preset, owned by OpenHands/automation. It is data, not code - there is no key that accepts JavaScript, no markup in copy, no free-form URL, and no secret value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "form",
        "review",
        "submit",
        "analytics"
      ],
      "properties": {
        "version": {
          "const": "1.0",
          "description": "Selects how this block is interpreted. A future format ships a new constant."
        },
        "mode": {
          "enum": ["direct", "assisted"],
          "description": "direct - the form produces a request body. assisted - the form seeds an agent conversation that finishes setup."
        },
        "requires": { "$ref": "#/$defs/requires" },
        "form": { "$ref": "#/$defs/form" },
        "validation": { "$ref": "#/$defs/validation" },
        "review": { "$ref": "#/$defs/review" },
        "submit": { "type": "object" },
        "analytics": { "$ref": "#/$defs/analytics" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "direct" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "submit": { "$ref": "#/$defs/directSubmit" } },
            "required": ["validation"]
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "assisted" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "submit": { "$ref": "#/$defs/assistedSubmit" } }
          }
        }
      ]
    },
    "copy": {
      "description": "Literal user-visible copy. Carries no markup, because a setup block must never inject HTML into the host.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "<[A-Za-z/!]" }
    },
    "placeholders": {
      "$comment": "Every {{ must open a known placeholder namespace and close immediately. `automation` resolves against the catalog entry this setup block belongs to.",
      "not": {
        "pattern": "\\{\\{(?!(form|automation|response|capabilities|submit)\\.[A-Za-z0-9_.]+\\}\\})"
      }
    },
    "templateCopy": {
      "description": "User-visible copy that may embed {{namespace.key}} placeholders.",
      "allOf": [
        { "$ref": "#/$defs/copy" },
        { "$ref": "#/$defs/placeholders" }
      ]
    },
    "templateValue": {
      "description": "A request-body string that may embed placeholders. Not rendered, so expression syntax such as a JMESPath filter is allowed.",
      "type": "string",
      "minLength": 1,
      "allOf": [{ "$ref": "#/$defs/placeholders" }]
    },
    "payloadValue": {
      "description": "A value in a request body. Nesting is allowed; there is nowhere to put code.",
      "oneOf": [
        { "$ref": "#/$defs/templateValue" },
        { "type": ["number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/payloadValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/payloadValue" }
        }
      ]
    },
    "requestBody": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/payloadValue" }
    },
    "servicePath": {
      "description": "Service-relative path. The deployment base path is resolved by the host, so a setup block cannot express an arbitrary request.",
      "type": "string",
      "pattern": "^/v1/[A-Za-z0-9/_-]*$"
    },
    "requires": {
      "description": "Stage 2. What the deployment must offer and what must be connected before setup can start. The host decides what to do when a requirement is unmet; an entry only states the requirement and why it exists.",
      "type": "object",
      "additionalProperties": false,
      "required": ["integrations"],
      "properties": {
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "message", "required"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Must resolve to an integrations/catalog entry id."
              },
              "message": { "$ref": "#/$defs/copy" },
              "required": {
                "type": "boolean",
                "description": "true blocks setup until the integration is connected. false lets setup continue without it."
              }
            }
          }
        },
        "features": {
          "description": "Deployment capabilities this automation cannot run without. Names are matched against the capabilities endpoint the host queries.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "form": {
      "description": "Stage 3. The inputs the user is asked for. These constraints also drive the host's local validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "note": { "$ref": "#/$defs/copy" },
        "triggers": {
          "description": "Inputs that decide when the automation runs, keyed by trigger kind. The key set is the trigger kinds the deployment must support, so it is not restated anywhere else.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cron": { "$ref": "#/$defs/formFields" },
            "event": { "$ref": "#/$defs/formFields" }
          }
        },
        "args": {
          "description": "Every other input: the arguments to the automation itself.",
          "$ref": "#/$defs/formFields"
        }
      }
    },
    "formFields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/formField" }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label", "help", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": {
          "description": "Semantic field types. The host renders a cron field without knowing what cron means to an automation, and resolves the deployment's schedule limits and timezone list for the cron and timezone types, so an entry never restates them.",
          "enum": [
            "text",
            "textarea",
            "select",
            "cron",
            "timezone",
            "repo-picker"
          ]
        },
        "label": { "$ref": "#/$defs/copy" },
        "help": { "$ref": "#/$defs/copy" },
        "placeholder": { "$ref": "#/$defs/copy" },
        "default": { "type": "string" },
        "required": { "type": "boolean" },
        "provider": { "enum": ["github", "gitlab", "bitbucket"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "$ref": "#/$defs/copy" }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 1 },
            "format": {
              "description": "A host-implemented check, named from a closed set. Setup blocks cannot supply their own regex, so one cannot hand the host a pathological pattern. safeExpressionLiteral marks a value that is interpolated into a filter expression string literal, so quotes and backslashes must be rejected before they can break the expression.",
              "enum": ["safeExpressionLiteral"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "repo-picker" } },
            "required": ["type"]
          },
          "then": { "required": ["provider"] }
        },
        {
          "if": {
            "properties": { "type": { "not": { "const": "select" } } },
            "required": ["type"]
          },
          "then": { "not": { "required": ["options"] } }
        }
      ]
    },
    "validation": {
      "description": "Stage 4. Omit preflight to declare that local validation is the only check available before submit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["onInvalid"],
      "properties": {
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "runOn", "body"],
          "properties": {
            "method": { "enum": ["POST"] },
            "path": { "$ref": "#/$defs/servicePath" },
            "runOn": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["fieldBlur", "beforeSubmit"] }
            },
            "debounceMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
            "body": { "$ref": "#/$defs/requestBody" }
          }
        },
        "onInvalid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "errorTarget"],
          "properties": {
            "behavior": { "const": "blockSubmit" },
            "errorTarget": { "enum": ["field", "form"] },
            "errorMap": {
              "description": "Payload path to form field name. An array maps one payload path back to every field that built it.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "review": {
      "description": "Stage 5. The plain-language summary the user confirms before anything is created.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "confirmLabel"],
      "properties": {
        "title": { "$ref": "#/$defs/copy" },
        "note": { "$ref": "#/$defs/copy" },
        "emptyValueText": { "$ref": "#/$defs/copy" },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "value": { "$ref": "#/$defs/templateCopy" }
            }
          }
        },
        "confirmLabel": { "$ref": "#/$defs/copy" }
      }
    },
    "directSubmit": {
      "description": "Stage 6, direct. Map form values into a request body and post it to an allowlisted capability.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "endpoint", "payload", "onSuccess", "onError"],
      "properties": {
        "action": { "const": "automation.create" },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["POST"] },
            "path": { "$ref": "#/$defs/servicePath" }
          }
        },
        "payload": { "$ref": "#/$defs/requestBody" },
        "onSuccess": { "$ref": "#/$defs/onSuccess" },
        "onError": { "$ref": "#/$defs/onError" }
      }
    },
    "assistedSubmit": {
      "description": "Stage 6, assisted. Hand the collected values to an agent conversation that finishes setup.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "message", "onSuccess", "onError"],
      "properties": {
        "action": { "const": "conversation.start" },
        "message": {
          "description": "Setup context only. Capped so this never becomes a channel for runtime instructions.",
          "allOf": [{ "$ref": "#/$defs/templateCopy" }, { "maxLength": 2000 }]
        },
        "onSuccess": { "$ref": "#/$defs/onSuccess" },
        "onError": { "$ref": "#/$defs/onError" }
      }
    },
    "onSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "to"],
      "properties": {
        "behavior": { "const": "navigate" },
        "to": {
          "description": "In-app destination only.",
          "allOf": [{ "$ref": "#/$defs/templateCopy" }, { "pattern": "^/" }]
        }
      }
    },
    "onError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "errorTarget"],
      "properties": {
        "behavior": { "const": "stayOnForm" },
        "errorTarget": { "enum": ["field", "form"] },
        "reuseErrorMap": { "type": "boolean" },
        "message": { "$ref": "#/$defs/copy" }
      }
    },
    "analytics": {
      "description": "Stage names and properties the host emits through its consent-aware telemetry service. Never user data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["consent", "stages"],
      "properties": {
        "consent": { "const": "required" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "on", "properties"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "on": {
                "enum": [
                  "route.entered",
                  "capabilities.resolved",
                  "validation.succeeded",
                  "submit.succeeded",
                  "submit.failed"
                ]
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                "additionalProperties": {
                  "oneOf": [
                    { "$ref": "#/$defs/templateValue" },
                    { "type": ["number", "boolean"] }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
