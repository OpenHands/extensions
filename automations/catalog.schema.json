{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenHands/extensions/automations/catalog.schema.json",
  "title": "AutomationCatalogEntry",
  "description": "Strict schema for automations/catalog/*.json. Mirrors automations/index.d.ts. An entry carries the card metadata Agent Canvas renders plus, optionally, the extension-owned setup contract for that automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description",
    "requiredIntegrationIds",
    "popularityRank",
    "estimatedSetupMinutes",
    "prompt",
    "exampleImplementation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable identifier. Must equal the filename stem."
    },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "requiredIntegrationIds": {
      "description": "Each id must resolve to an integrations/catalog entry.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "popularityRank": { "type": "integer", "minimum": 0 },
    "estimatedSetupMinutes": { "type": "integer", "minimum": 1 },
    "prompt": {
      "description": "The slash command Agent Canvas sends when the card is launched today.",
      "type": "string",
      "minLength": 1
    },
    "exampleImplementation": {
      "description": "What the skill behind `prompt` builds. Documentation for authors; Agent Canvas does not render it.",
      "type": "string",
      "minLength": 1
    },
    "setup": { "$ref": "#/$defs/setup" }
  },
  "$defs": {
    "setup": {
      "description": "The extension-owned configuration experience for this automation: what the deployment must support, what must be connected first, what the user is asked, how a draft is validated, what request is sent, and which analytics stages are emitted. It never describes what the automation does at runtime - that is the preset, owned by OpenHands/automation. It is data, not code - there is no key that accepts JavaScript, no markup in copy, no free-form URL, and no secret value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "routes",
        "form",
        "review",
        "submit",
        "analytics"
      ],
      "properties": {
        "version": {
          "const": "1.0",
          "description": "Selects how this block is interpreted. A future format ships a new constant."
        },
        "mode": {
          "enum": ["direct", "assisted"],
          "description": "direct - the form produces a request body. assisted - the form seeds an agent conversation that finishes setup."
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "requires": { "$ref": "#/$defs/requires" },
        "form": { "$ref": "#/$defs/form" },
        "validation": { "$ref": "#/$defs/validation" },
        "review": { "$ref": "#/$defs/review" },
        "submit": { "type": "object" },
        "analytics": { "$ref": "#/$defs/analytics" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "direct" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "submit": { "$ref": "#/$defs/directSubmit" } },
            "required": ["validation"]
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "assisted" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "submit": { "$ref": "#/$defs/assistedSubmit" } }
          }
        }
      ]
    },
    "copy": {
      "description": "Literal user-visible copy. Carries no markup, because a setup block must never inject HTML into the host.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "<[A-Za-z/!]" }
    },
    "placeholders": {
      "$comment": "Every {{ must open a known placeholder namespace and close immediately. `automation` resolves against the catalog entry this setup block belongs to.",
      "not": {
        "pattern": "\\{\\{(?!(form|automation|response|capabilities|submit)\\.[A-Za-z0-9_.]+\\}\\})"
      }
    },
    "templateCopy": {
      "description": "User-visible copy that may embed {{namespace.key}} placeholders.",
      "allOf": [
        { "$ref": "#/$defs/copy" },
        { "$ref": "#/$defs/placeholders" }
      ]
    },
    "templateValue": {
      "description": "A request-body string that may embed placeholders. Not rendered, so expression syntax such as a JMESPath filter is allowed.",
      "type": "string",
      "minLength": 1,
      "allOf": [{ "$ref": "#/$defs/placeholders" }]
    },
    "payloadValue": {
      "description": "A value in a request body. Nesting is allowed; there is nowhere to put code.",
      "oneOf": [
        { "$ref": "#/$defs/templateValue" },
        { "type": ["number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/payloadValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/payloadValue" }
        }
      ]
    },
    "requestBody": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/payloadValue" }
    },
    "servicePath": {
      "description": "Service-relative path. The deployment base path is resolved by the host, so a setup block cannot express an arbitrary request.",
      "type": "string",
      "pattern": "^/v1/[A-Za-z0-9/_-]*$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "page"],
      "properties": {
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$" },
        "page": { "enum": ["setup"] }
      }
    },
    "capabilities": {
      "description": "Stage 2. What the deployment must support for this automation to be offered at all.",
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "requires", "onUnsupported"],
      "properties": {
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET"] },
            "path": { "$ref": "#/$defs/servicePath" }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "triggerKinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["cron", "event"] }
            },
            "eventSources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "eventTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "features": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "ready": { "const": true }
          }
        },
        "bindings": {
          "description": "Feeds deployment values into form field constraints, so the form offers only what the deployment accepts.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "constraint", "from"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "constraint": { "enum": ["options", "minIntervalSeconds"] },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
              }
            }
          }
        },
        "onUnsupported": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "message"],
          "properties": {
            "behavior": { "const": "block" },
            "message": { "$ref": "#/$defs/copy" }
          }
        }
      }
    },
    "requires": {
      "description": "Stages 3 and 4. Integrations that must be connected and credentials that must be present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["integrations", "secrets", "onUnmet"],
      "properties": {
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason", "enforcement"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Must resolve to an integrations/catalog entry id."
              },
              "reason": { "$ref": "#/$defs/copy" },
              "enforcement": { "enum": ["block", "warn"] }
            }
          }
        },
        "secrets": {
          "description": "Credential names only. additionalProperties is false, so there is nowhere to put a value.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "help", "required"],
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "label": { "$ref": "#/$defs/copy" },
              "help": { "$ref": "#/$defs/copy" },
              "required": { "type": "boolean" }
            }
          }
        },
        "onUnmet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "message"],
          "properties": {
            "behavior": { "const": "block" },
            "message": { "$ref": "#/$defs/copy" }
          }
        },
        "onWarn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "message"],
          "properties": {
            "behavior": { "const": "continue" },
            "message": { "$ref": "#/$defs/copy" }
          }
        }
      }
    },
    "form": {
      "description": "Stage 5. The inputs the user is asked for. These constraints also drive the host's local validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "note": { "$ref": "#/$defs/copy" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/formField" }
        }
      }
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label", "help", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": {
          "description": "Semantic field types. The host renders a cron field without knowing what cron means to an automation.",
          "enum": ["text", "textarea", "select", "cron", "repo-picker"]
        },
        "label": { "$ref": "#/$defs/copy" },
        "help": { "$ref": "#/$defs/copy" },
        "placeholder": { "$ref": "#/$defs/copy" },
        "default": { "type": "string" },
        "required": { "type": "boolean" },
        "provider": { "enum": ["github", "gitlab", "bitbucket"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "$ref": "#/$defs/copy" }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 1 },
            "format": {
              "description": "A host-implemented check, named from a closed set. Setup blocks cannot supply their own regex, so one cannot hand the host a pathological pattern. safeExpressionLiteral marks a value that is interpolated into a filter expression string literal, so quotes and backslashes must be rejected before they can break the expression.",
              "enum": ["safeExpressionLiteral"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "repo-picker" } },
            "required": ["type"]
          },
          "then": { "required": ["provider"] }
        },
        {
          "if": {
            "properties": { "type": { "not": { "const": "select" } } },
            "required": ["type"]
          },
          "then": { "not": { "required": ["options"] } }
        }
      ]
    },
    "validation": {
      "description": "Stage 6. Omit preflight to declare that local validation is the only check available before submit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["onInvalid"],
      "properties": {
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "runOn", "body"],
          "properties": {
            "method": { "enum": ["POST"] },
            "path": { "$ref": "#/$defs/servicePath" },
            "runOn": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["fieldBlur", "beforeSubmit"] }
            },
            "debounceMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
            "body": { "$ref": "#/$defs/requestBody" }
          }
        },
        "onInvalid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "errorTarget"],
          "properties": {
            "behavior": { "const": "blockSubmit" },
            "errorTarget": { "enum": ["field", "form"] },
            "errorMap": {
              "description": "Payload path to form field name. An array maps one payload path back to every field that built it.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "review": {
      "description": "Stage 7. The plain-language summary the user confirms before anything is created.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "confirmLabel"],
      "properties": {
        "title": { "$ref": "#/$defs/copy" },
        "note": { "$ref": "#/$defs/copy" },
        "emptyValueText": { "$ref": "#/$defs/copy" },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "value": { "$ref": "#/$defs/templateCopy" }
            }
          }
        },
        "confirmLabel": { "$ref": "#/$defs/copy" }
      }
    },
    "directSubmit": {
      "description": "Stage 8, direct. Map form values into a request body and post it to an allowlisted capability.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "endpoint", "payload", "onSuccess", "onError"],
      "properties": {
        "action": { "const": "automation.create" },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["POST"] },
            "path": { "$ref": "#/$defs/servicePath" }
          }
        },
        "payload": { "$ref": "#/$defs/requestBody" },
        "onSuccess": { "$ref": "#/$defs/onSuccess" },
        "onError": { "$ref": "#/$defs/onError" }
      }
    },
    "assistedSubmit": {
      "description": "Stage 8, assisted. Hand the collected values to an agent conversation that finishes setup.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "message", "onSuccess", "onError"],
      "properties": {
        "action": { "const": "conversation.start" },
        "message": {
          "description": "Setup context only. Capped so this never becomes a channel for runtime instructions.",
          "allOf": [{ "$ref": "#/$defs/templateCopy" }, { "maxLength": 2000 }]
        },
        "onSuccess": { "$ref": "#/$defs/onSuccess" },
        "onError": { "$ref": "#/$defs/onError" }
      }
    },
    "onSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "to"],
      "properties": {
        "behavior": { "const": "navigate" },
        "to": {
          "description": "In-app destination only.",
          "allOf": [{ "$ref": "#/$defs/templateCopy" }, { "pattern": "^/" }]
        }
      }
    },
    "onError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "errorTarget"],
      "properties": {
        "behavior": { "const": "stayOnForm" },
        "errorTarget": { "enum": ["field", "form"] },
        "reuseErrorMap": { "type": "boolean" },
        "message": { "$ref": "#/$defs/copy" }
      }
    },
    "analytics": {
      "description": "Stage names and properties the host emits through its consent-aware telemetry service. Never user data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["consent", "stages"],
      "properties": {
        "consent": { "const": "required" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "on", "properties"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "on": {
                "enum": [
                  "route.entered",
                  "capabilities.resolved",
                  "validation.succeeded",
                  "submit.succeeded",
                  "submit.failed"
                ]
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                "additionalProperties": {
                  "oneOf": [
                    { "$ref": "#/$defs/templateValue" },
                    { "type": ["number", "boolean"] }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
