{
  "manifestVersion": "1.0",
  "id": "github-pr-reviewer",
  "name": "GitHub Code Review Agent",
  "category": "Code review",
  "description": "Poll a repository on a schedule and post an AI review on pull requests carrying a configured label.",
  "setupMode": "direct",

  "routes": [
    {
      "path": "/automations/new/github-pr-reviewer",
      "page": "setup"
    }
  ],

  "capabilities": {
    "discovery": {
      "method": "GET",
      "path": "/v1/capabilities"
    },
    "requires": {
      "triggerKinds": ["cron"],
      "features": ["repoClone", "presetPrompt"],
      "ready": true
    },
    "bindings": [
      {
        "field": "schedule",
        "constraint": "minIntervalSeconds",
        "from": "triggers.cron.minIntervalSeconds"
      },
      {
        "field": "timezone",
        "constraint": "options",
        "from": "triggers.cron.timezones"
      }
    ],
    "onUnsupported": {
      "behavior": "block",
      "message": "This deployment cannot run scheduled automations, so the code review agent is unavailable here."
    }
  },

  "requires": {
    "integrations": [
      {
        "id": "github",
        "reason": "Used to read pull requests and post review comments.",
        "enforcement": "block"
      }
    ],
    "secrets": [
      {
        "key": "GITHUB_PERSONAL_ACCESS_TOKEN",
        "label": "GitHub personal access token",
        "help": "Needs read access to the repository and permission to comment on pull requests.",
        "required": true
      }
    ],
    "onUnmet": {
      "behavior": "block",
      "message": "Connect GitHub and provide an access token before continuing."
    }
  },

  "form": {
    "fields": [
      {
        "name": "repository",
        "type": "repo-picker",
        "label": "Repository",
        "help": "The repository whose pull requests will be reviewed.",
        "provider": "github",
        "required": true
      },
      {
        "name": "baseRef",
        "type": "text",
        "label": "Base branch",
        "help": "Branch checked out when the review runs.",
        "default": "main",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      },
      {
        "name": "triggerLabel",
        "type": "text",
        "label": "Trigger label",
        "help": "Only pull requests carrying this label are reviewed.",
        "default": "openhands-review",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 50
        }
      },
      {
        "name": "reviewTone",
        "type": "select",
        "label": "Review tone",
        "help": "How detailed the review comments should be.",
        "default": "concise",
        "required": true,
        "options": [
          { "value": "concise", "label": "Concise" },
          { "value": "thorough", "label": "Thorough" }
        ]
      },
      {
        "name": "schedule",
        "type": "cron",
        "label": "Check frequency",
        "help": "How often to look for newly labelled pull requests.",
        "default": "*/15 * * * *",
        "required": true
      },
      {
        "name": "timezone",
        "type": "select",
        "label": "Timezone",
        "help": "Timezone the schedule is interpreted in. Options come from the deployment.",
        "default": "UTC",
        "required": true
      }
    ]
  },

  "validation": {
    "preflight": {
      "method": "POST",
      "path": "/v1/validate",
      "runOn": ["fieldBlur", "beforeSubmit"],
      "debounceMs": 400,
      "body": {
        "manifestId": "{{manifest.id}}",
        "endpoint": "/v1/preset/prompt",
        "draft": "{{submit.payload}}"
      }
    },
    "onInvalid": {
      "behavior": "blockSubmit",
      "errorTarget": "field",
      "errorMap": {
        "name": "repository",
        "repos[0].url": "repository",
        "repos[0].ref": "baseRef",
        "trigger.schedule": "schedule",
        "trigger.timezone": "timezone",
        "prompt": ["triggerLabel", "reviewTone", "repository"]
      }
    }
  },

  "review": {
    "title": "Review before creating",
    "summary": [
      { "label": "Repository", "value": "{{form.repository}} ({{form.baseRef}})" },
      { "label": "Reviews pull requests labelled", "value": "{{form.triggerLabel}}" },
      { "label": "Tone", "value": "{{form.reviewTone}}" },
      { "label": "Runs", "value": "{{form.schedule}} ({{form.timezone}})" }
    ],
    "confirmLabel": "Create automation"
  },

  "submit": {
    "action": "automation.create",
    "endpoint": {
      "method": "POST",
      "path": "/v1/preset/prompt"
    },
    "payload": {
      "name": "PR Reviewer - {{form.repository}}",
      "prompt": "Review pull requests labeled '{{form.triggerLabel}}' in {{form.repository}}. Review tone: {{form.reviewTone}}.",
      "repos": [
        {
          "url": "{{form.repository}}",
          "ref": "{{form.baseRef}}",
          "provider": "github"
        }
      ],
      "trigger": {
        "type": "cron",
        "schedule": "{{form.schedule}}",
        "timezone": "{{form.timezone}}"
      }
    },
    "onSuccess": {
      "behavior": "navigate",
      "to": "/automations/{{response.id}}"
    },
    "onError": {
      "behavior": "stayOnForm",
      "errorTarget": "field",
      "reuseErrorMap": true
    }
  },

  "analytics": {
    "consent": "required",
    "stages": [
      {
        "id": "setup_opened",
        "on": "route.entered",
        "properties": {
          "automation_id": "{{manifest.id}}",
          "setup_mode": "direct"
        }
      },
      {
        "id": "capabilities_checked",
        "on": "capabilities.resolved",
        "properties": {
          "automation_id": "{{manifest.id}}",
          "supported": "{{capabilities.supported}}"
        }
      },
      {
        "id": "setup_validated",
        "on": "validation.succeeded",
        "properties": {
          "automation_id": "{{manifest.id}}"
        }
      },
      {
        "id": "setup_submitted",
        "on": "submit.succeeded",
        "properties": {
          "automation_id": "{{manifest.id}}",
          "setup_mode": "direct",
          "trigger_kind": "cron"
        }
      },
      {
        "id": "setup_failed",
        "on": "submit.failed",
        "properties": {
          "automation_id": "{{manifest.id}}",
          "setup_mode": "direct"
        }
      }
    ]
  }
}
